# Exemple manuel. Pour une nouvelle installation, suivez INSTALLATION.md et utilisez /install.php.
# Production : PHP 8.2+, pdo_mysql, mbstring et openssl ; base MySQL existante et dédiée.
APP_ENV=production
APP_ORIGIN=https://votre-domaine.tn
DB_DRIVER=mysql
# Dossier privé persistant hors public/ pour les images téléversées.
MEDIA_PATH=data/media
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cmcb
DB_USER=cmcb
DB_PASSWORD=
# Chemin absolu vers la CA de confiance MySQL ; obligatoire si DB_HOST est distant en production.
DB_SSL_CA=
# Nombre exact de proxys de confiance. 0 si accès direct.
TRUST_PROXY=0
SESSION_COOKIE_SAMESITE=strict
PREVIEW_BEARER_AUTH=false

# Utilisés uniquement par php bin/admin-create.php (réinitialisation CLI).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Sans SMTP, les demandes sont conservées et visibles dans l’administration.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFICATION_EMAIL=
