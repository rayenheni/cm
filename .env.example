# Node 22.16+; run all commands from the repository root.
PORT=5173
DATABASE_PATH=data/cmcb.sqlite
# Writable persistent storage outside the web root; include it in backups.
MEDIA_PATH=data/media
# Required in production; exact public HTTPS origin, no trailing path.
APP_ORIGIN=https://cmcbavocat.tn
# Only set behind a trusted reverse proxy. Number of proxy hops, not true/false.
TRUST_PROXY=0
# Use none ONLY behind an HTTPS embedded preview (e.g. Arena). Keep strict locally.
# none enables Secure + SameSite=None + Partitioned (CHIPS).
SESSION_COOKIE_SAMESITE=strict
# Development-only Arena fallback when third-party cookies are blocked.
# Uses an in-memory Bearer session; never enabled in production.
PREVIEW_BEARER_AUTH=false

# Used only by npm run admin:create. Remove ADMIN_PASSWORD after provisioning.
ADMIN_EMAIL=admin@example.com
# Replace with a unique 12–128 character password; never commit the real .env.
ADMIN_PASSWORD=

# Optional: without SMTP, requests still persist and appear in the admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CMCB <consultations@cmcbavocat.tn>
NOTIFICATION_EMAIL=maitrechaimabhiri@gmail.com
